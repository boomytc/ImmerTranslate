{
  "manifest_version": 3,
  "name": "ImmerTranslate",
  "version": "0.7.0",
  "description": "网页主内容双语对照阅读（MVP 壳）",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ImmerTranslate",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-page-translate": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A",
        "windows": "Alt+A",
        "linux": "Alt+A",
        "chromeos": "Alt+A"
      },
      "description": "切换整页翻译或显示原文"
    },
    "translate-hovered-paragraph": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T",
        "windows": "Alt+T",
        "linux": "Alt+T",
        "chromeos": "Alt+T"
      },
      "description": "翻译当前悬停的段落"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["hotkey.js", "sitelist.js", "ballpos.js", "onboarding.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["glass.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
